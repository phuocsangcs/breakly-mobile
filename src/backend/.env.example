# Copy to .env (git-ignored) and fill in. Loaded by application.yml (spring.config.import).
# Free Jamendo client ID: https://devportal.jamendo.com -> Your account -> create a "Read only" app.
# Without it, every radio station plays the same 3 demo tracks and MP3 download is unavailable.
JAMENDO_CLIENT_ID=
# Optional: YouTube Data API key for video metadata.
YOUTUBE_API_KEY=
